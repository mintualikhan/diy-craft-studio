<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>DIY Craft Studio</title>
  <meta name="description" content="DIY Craft Studio – Creative DIY crafts, smart life hacks and satisfying videos." />
  <style>
    body{
      margin:0;
      font-family: Arial, Helvetica, sans-serif;
      background:#f9f9f9;
      color:#333;
    }
    header{
      background:#ff7a18;
      background:linear-gradient(90deg,#ff7a18,#ffb347);
      color:#fff;
      padding:60px 20px;
      text-align:center;
    }
    header h1{font-size:42px;margin:0;}
    header p{font-size:18px;max-width:700px;margin:15px auto;}
    .btn{
      display:inline-block;
      margin-top:20px;
      padding:12px 28px;
      background:#fff;
      color:#ff7a18;
      text-decoration:none;
      font-weight:bold;
      border-radius:30px;
    }
    section{
      padding:60px 20px;
      max-width:1100px;
      margin:auto;
    }
    .grid{
      display:grid;
      grid-template-columns:repeat(auto-fit,minmax(250px,1fr));
      gap:30px;
    }
    .card{
      background:#fff;
      border-radius:16px;
      padding:30px;
      box-shadow:0 10px 25px rgba(0,0,0,0.08);
      text-align:center;
    }
    .card h3{margin-top:10px;}
    .about{
      background:#fff;
      border-radius:20px;
      padding:40px;
      box-shadow:0 10px 25px rgba(0,0,0,0.08);
    }
    footer{
      background:#222;
      color:#ccc;
      text-align:center;
      padding:30px 20px;
    }
    footer a{color:#ffb347;text-decoration:none;}
  </style>
</head>
<body>

<header>
  <h1>DIY Craft Studio</h1>
  <p>Creative DIY crafts, smart life hacks & satisfying videos. Easy ideas you can try at home.</p>
  <a class="btn" href="#contact">Contact Us</a>
</header>

<section>
  <h2 style="text-align:center;">What We Share</h2>
  <div class="grid">
    <div class="card">
      <h3>DIY Crafts</h3>
      <p>Simple and creative craft ideas for everyone.</p>
    </div>
    <div class="card">
      <h3>Life Hacks</h3>
      <p>Smart hacks that make daily life easier.</p>
    </div>
    <div class="card">
      <h3>Satisfying Videos</h3>
      <p>Relaxing and oddly satisfying DIY creations.</p>
    </div>
  </div>
</section>

<section>
  <div class="about">
    <h2>About DIY Craft Studio</h2>
    <p>
      DIY Craft Studio is a creative platform dedicated to sharing inspiring DIY craft videos, 
      home projects, life hacks and satisfying creations. Our goal is to make creativity simple, 
      fun and accessible for everyone.
    </p>
  </div>
</section>

<section id="contact">
  <h2 style="text-align:center;">Contact</h2>
  <div class="card" style="max-width:500px;margin:auto;">
    <p>Email: <strong>contact.diycraftstudio@gmail.com</strong></p>
    <p>Facebook Page: <strong>DIY Craft Studio</strong></p>
  </div>
</section>

<footer>
  <p>© 2026 DIY Craft Studio. All rights reserved.</p>
  <p>Follow us on <a href="#">Facebook</a></p>
</footer>

</body>
</html>
